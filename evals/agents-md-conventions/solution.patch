+/// Parses a TCP port from 1 to 65535.
+pub fn parse_port(text: &str) -> Result<u16, Error> {
+    match text.parse::<u16>() {
+        Ok(port) if port > 0 => Ok(port),
+        _ => Err(Error::Invalid(text.to_string())),
+    }
