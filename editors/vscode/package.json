{
  "name": "harness",
  "displayName": "Harness",
  "description": "Local-first coding agent harness",
  "publisher": "harness",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.145.0" },
  "main": "./dist/harness_vscode.js",
  "capabilities": { "untrustedWorkspaces": { "supported": false } },
  "contributes": {
    "commands": [{ "command": "harness.open", "title": "Harness: Open Chat" }],
    "configuration": {
      "title": "Harness",
      "properties": {
        "harness.binaryPath": {
          "type": "string",
          "default": "harness",
          "scope": "machine",
          "description": "Path to the harness binary. Machine-scoped so a workspace can't change it."
        }
      }
    }
  }
}
