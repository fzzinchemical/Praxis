{
  "name": "praxis",
  "displayName": "Praxis",
  "description": "Local-first coding agent",
  "publisher": "praxis",
  "version": "1.3.0-beta",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.145.0" },
  "main": "./dist/praxis_vscode.js",
  "capabilities": { "untrustedWorkspaces": { "supported": false } },
  "contributes": {
    "commands": [
      { "command": "praxis.open", "title": "Praxis: Open Chat" },
      { "command": "praxis.newSession", "title": "Praxis: New Session", "icon": "$(add)" },
      { "command": "praxis.openSession", "title": "Praxis: Open Session" },
      { "command": "praxis.refreshSessions", "title": "Praxis: Refresh Sessions", "icon": "$(refresh)" },
      { "command": "praxis.deleteSession", "title": "Praxis: Delete Session" },
      { "command": "praxis.moveSessionToFolder", "title": "Praxis: Move Session to Folder" },
      { "command": "praxis.enablePlugin", "title": "Praxis: Enable Plugin" },
      { "command": "praxis.disablePlugin", "title": "Praxis: Disable Plugin" },
      { "command": "praxis.removePlugin", "title": "Praxis: Remove Plugin" },
      { "command": "praxis.showPlugin", "title": "Praxis: Show Plugin Details" },
      { "command": "praxis.installPlugin", "title": "Praxis: Install Plugin", "icon": "$(add)" },
      { "command": "praxis.refreshPlugins", "title": "Praxis: Refresh Plugins", "icon": "$(refresh)" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "praxis", "title": "Praxis", "icon": "media/praxis.svg" }]
    },
    "views": {
      "praxis": [
        { "id": "praxis.sessions", "name": "Sessions" },
        { "id": "praxis.plugins", "name": "Plugins" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "praxis.newSession", "when": "view == praxis.sessions", "group": "navigation" },
        { "command": "praxis.refreshSessions", "when": "view == praxis.sessions", "group": "navigation" },
        { "command": "praxis.installPlugin", "when": "view == praxis.plugins", "group": "navigation" },
        { "command": "praxis.refreshPlugins", "when": "view == praxis.plugins", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "praxis.moveSessionToFolder", "when": "view == praxis.sessions && viewItem == session", "group": "1_move" },
        { "command": "praxis.deleteSession", "when": "view == praxis.sessions && viewItem == session", "group": "2_remove" },
        { "command": "praxis.enablePlugin", "when": "view == praxis.plugins && viewItem == plugin-disabled", "group": "1_state" },
        { "command": "praxis.disablePlugin", "when": "view == praxis.plugins && viewItem == plugin-enabled", "group": "1_state" },
        { "command": "praxis.removePlugin", "when": "view == praxis.plugins && viewItem =~ /^plugin-/", "group": "2_remove" }
      ],
      "commandPalette": [
        { "command": "praxis.openSession", "when": "false" },
        { "command": "praxis.deleteSession", "when": "false" },
        { "command": "praxis.moveSessionToFolder", "when": "false" },
        { "command": "praxis.enablePlugin", "when": "false" },
        { "command": "praxis.disablePlugin", "when": "false" },
        { "command": "praxis.removePlugin", "when": "false" },
        { "command": "praxis.showPlugin", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Praxis",
      "properties": {
        "praxis.binaryPath": {
          "type": "string",
          "default": "praxis",
          "scope": "machine",
          "description": "Path to the praxis binary. Machine-scoped so a workspace can't change it."
        },
        "praxis.defaultModel": {
          "type": "string",
          "description": "Model key for new runs. Unset uses config.toml (default_model)."
        },
        "praxis.permissions.mode": {
          "type": "string",
          "enum": ["read-only", "ask", "auto-edit", "full-access"],
          "scope": "machine",
          "markdownDescription": "Permission mode for tool calls. `full-access` runs `Bash` and MCP tools without asking, still under the hard denials. Machine-scoped so a workspace can't raise it. Unset uses config.toml (permissions.mode)."
        },
        "praxis.lmstudio.baseUrl": {
          "type": "string",
          "scope": "machine",
          "description": "LM Studio server URL. Machine-scoped so a workspace can't send prompts to another server. Unset uses config.toml (lmstudio.base_url)."
        },
        "praxis.agent.maxTurnRequests": {
          "type": "integer",
          "minimum": 0,
          "description": "Model requests allowed in one turn. Unset uses config.toml (agent.max_turn_requests)."
        },
        "praxis.context.maskKeepTurns": {
          "type": "integer",
          "minimum": 0,
          "description": "Recent turns whose tool output stays unmasked. Unset uses config.toml (context.mask_keep_turns)."
        },
        "praxis.context.filterOutput": {
          "type": "boolean",
          "description": "Filter noisy tool output before the model sees it. Unset uses config.toml (context.filter_output)."
        }
      }
    }
  }
}
