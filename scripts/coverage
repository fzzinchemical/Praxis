#!/usr/bin/env bash
# Runs native tests under cargo-llvm-cov and fails if a line-coverage floor in scripts/coverage-floors is missed (SPEC §14).
set -euo pipefail
cd "$(dirname "$0")/.."

# Pacman's llvm tools are unversioned only under /usr/bin and rustup is absent, so cargo-llvm-cov must be pointed at them.
export LLVM_COV="${LLVM_COV:-/usr/bin/llvm-cov}" LLVM_PROFDATA="${LLVM_PROFDATA:-/usr/bin/llvm-profdata}"
# Same scope as verify: wasm crates stay off native builds.
native=(--workspace --exclude praxis-vscode --exclude praxis-vscode-ui)

cargo llvm-cov --no-report -q "${native[@]}"
json="$(cargo llvm-cov report --summary-only --json)"

failed=0
while read -r name pattern floor; do
    [[ -z "${name:-}" || "$name" == \#* ]] && continue
    # Test files and fixtures are not product code, so they never count toward a floor.
    actual="$(jq -r --arg re "$pattern" '
        [.data[0].files[]
         | select(.filename | test($re))
         | select((.filename | test("/tests/|/evals/")) | not)
         | .summary.lines]
        | "\(map(.covered) | add // 0) \(map(.count) | add // 0)"' <<<"$json" |
        awk '{ printf "%.4f", ($2 ? 100 * $1 / $2 : 0) }')"
    shown="$(awk -v a="$actual" 'BEGIN { printf "%.1f", a }')"
    # Compare unrounded: a display rounded up must never pass a floor the real value misses.
    if awk -v a="$actual" -v f="$floor" 'BEGIN { exit !(a + 0 < f + 0) }'; then
        echo "coverage: $name $shown% < floor $floor%" >&2
        failed=1
    else
        echo "coverage: $name $shown% >= floor $floor%"
    fi
done <scripts/coverage-floors

exit "$failed"
